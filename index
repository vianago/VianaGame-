<meta charset="utf-8">
<title>VIANA</title>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<style>
/* Layout: one centered handheld screen. Two stacked canvases: #screen (world, 240x160) and #ui (pixel-art interface,
   drawn at its own integer pixel grid). Touch pad below on phones. All interface art lives in u1..u7. */
:root{
  color-scheme: dark;
  --night:#120f14; --night2:#1d1a24;
  --paper:#f7eedb; --paper2:#efe1c4; --paper3:#e4d1ad; --white:#fffaf0;
  --ink:#1c1714; --ink2:#3a2e26; --muted:#7a6650;
  --ver:#e0432b; --ver2:#8e1f1c; --forest:#2f5b3a; --turq:#3aa6a0; --slate:#5b6f80; --brown:#8a5a32; --gold:#e8b23a;
  --chipfg:#fff6e6;
  --display:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
  --font:ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
  --u:3;
}
[hidden]{display:none!important}
html,body{height:100%;margin:0}
body{background:var(--night);color:var(--chipfg);font-family:var(--font);
  background-image:radial-gradient(ellipse at 50% -10%, #3a1c1c 0%, transparent 55%),radial-gradient(ellipse at 50% 120%, #10262a 0%, transparent 60%);
  -webkit-user-select:none;user-select:none;overflow-x:hidden}
#app{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding-inline:16px;padding-block:10px;box-sizing:border-box}
#stage{position:relative;width:720px;height:480px;max-width:100%;background:#000;
  box-shadow:0 0 0 calc(var(--u)*1px) #0b0a0c,0 0 0 calc(var(--u)*2.4px) #5a1f1a,0 0 0 calc(var(--u)*3.2px) #0b0a0c,0 20px 60px rgba(0,0,0,.6);
  border-radius:calc(var(--u)*1.5px);overflow:hidden;touch-action:none}
#screen,#ui{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;display:block}
#ui{touch-action:none}
/* pad: on touch screens the game fills the screen and the controls float above it, small and translucent */
#pad{display:none;touch-action:none}
.pbtn{all:unset;box-sizing:border-box;display:grid;place-items:center;font-family:var(--display);font-weight:700;color:#f4e9d2;
  background:rgba(28,23,20,.55);border:2px solid rgba(244,233,210,.35);-webkit-tap-highlight-color:transparent;opacity:.7;transition:opacity .15s}
.pbtn.on{opacity:1;background:rgba(28,23,20,.85);transform:translateY(1px)}
.dpad{display:grid;grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px)}
.dpad .pbtn{border-radius:8px;font-size:13px}
.dpad .up{grid-area:1/2}.dpad .left{grid-area:2/1}.dpad .right{grid-area:2/3}.dpad .down{grid-area:3/2}
.abtns{display:grid;grid-template-columns:46px 54px;grid-template-rows:54px 26px;gap:6px 8px;align-items:end}
.pbtn.a{background:rgba(224,67,43,.72);border-color:rgba(255,224,200,.55);border-radius:50%;width:54px;height:54px;font-size:18px}
.pbtn.b{background:rgba(63,79,93,.7);border-radius:50%;width:44px;height:44px;font-size:15px;justify-self:center}
.pbtn.s,.pbtn.m{height:26px;border-radius:13px;font-size:10px;letter-spacing:.08em;padding:0 6px}
.pbtn.s{background:rgba(94,59,32,.7)}
.keys{margin:0;font-size:12px;color:#a8977d;text-align:center;letter-spacing:.04em;max-width:900px;font-family:var(--font)}
.keys kbd{font-family:var(--display);background:#2c2430;color:#f1e3c8;border-radius:3px;padding:0 5px;box-shadow:0 2px 0 #120e14}
body.touch #app{padding:0;gap:0;height:100vh;height:100dvh;justify-content:center;overflow:hidden}
body.touch #stage{border-radius:0;box-shadow:none;max-width:none}
body.touch .keys{display:none}
body.touch #pad{display:flex;position:fixed;left:0;right:0;bottom:0;justify-content:space-between;align-items:flex-end;
  padding:0 10px calc(10px + env(safe-area-inset-bottom)) calc(10px + env(safe-area-inset-left));pointer-events:none;z-index:5}
body.touch #pad .pbtn{pointer-events:auto}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01s!important}}
</style>

<div id="app">
  <div id="stage">
    <canvas id="screen" width="240" height="160"></canvas>
    <canvas id="ui" aria-label="Interfaz del juego"></canvas>
  </div>
  <div id="pad">
    <div class="dpad">
      <button class="pbtn up" data-k="up" aria-label="Arriba">▲</button>
      <button class="pbtn left" data-k="left" aria-label="Izquierda">◀</button>
      <button class="pbtn right" data-k="right" aria-label="Derecha">▶</button>
      <button class="pbtn down" data-k="down" aria-label="Abajo">▼</button>
    </div>
    <div class="abtns">
      <button class="pbtn b" data-k="b">B</button>
      <button class="pbtn a" data-k="a">A</button>
      <button class="pbtn s" data-k="sniff">OLFATO</button>
      <button class="pbtn m" data-k="menu">MENÚ</button>
    </div>
  </div>
  <p class="keys"><kbd>WASD</kbd>/<kbd>flechas</kbd> moverse · <kbd>mantener clic</kbd> caminar hacia ahí · <kbd>Z</kbd>/<kbd>Espacio</kbd> interactuar (A) · <kbd>X</kbd> correr / volver (B) · <kbd>C</kbd> olfato de Stinky · <kbd>M</kbd> cuaderno</p>
</div>
<script>
'use strict';
/* =========================================================
   UNRYU — prototipo jugable (vertical slice)
   Módulos: CORE · INPUT · AUDIO · SPRITES · TILES · MAPS ·
            STATE · NPC · STORY · CREATURES · MINIGAME · UI · LOOP
   ========================================================= */
let W = 240, H = 160; const TS = 16; // W/H se adaptan a la forma de la pantalla (ver fit)
const screen = document.getElementById('screen');
const ctx = screen.getContext('2d');
ctx.imageSmoothingEnabled = false;
const $ = s => document.querySelector(s);

function mk(w, h) { const c = document.createElement('canvas'); c.width = w; c.height = h; const x = c.getContext('2d'); x.imageSmoothingEnabled = false; return [c, x]; }
function R(x, c, X, Y, w = 1, h = 1) { x.fillStyle = c; x.fillRect(X, Y, w, h); }
function hash(a, b, s = 0) { let h = Math.imul(a | 0, 374761393) ^ Math.imul(b | 0, 668265263) ^ Math.imul(s | 0, 982451653); h = Math.imul(h ^ (h >>> 13), 1274126177); h ^= h >>> 16; return (h >>> 0) / 4294967296; }
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const rev = s => s.split('').reverse().join('');
const rnd = (a, b) => a + Math.random() * (b - a);
const pick = a => a[Math.floor(Math.random() * a.length)];
const money = n => '$' + Math.round(n).toLocaleString('es-CL');
const sleep = ms => new Promise(r => setTimeout(r, ms));

function grid(rows, pal, name) {
  const h = rows.length, w = rows[0].length;
  for (const r of rows) if (r.length !== w) console.warn('grid width', name, JSON.stringify(r), r.length, 'expected', w);
  const [c, x] = mk(w, h);
  for (let y = 0; y < h; y++) for (let i = 0; i < w; i++) { const col = pal[rows[y][i]]; if (col) R(x, col, i, y); }
  return c;
}
function flipC(c) { const [d, x] = mk(c.width, c.height); x.translate(c.width, 0); x.scale(-1, 1); x.drawImage(c, 0, 0); return d; }
function silhouette(c, col) { const [d, x] = mk(c.width, c.height); x.drawImage(c, 0, 0); x.globalCompositeOperation = 'source-in'; R(x, col, 0, 0, c.width, c.height); return d; }
// pixel disc
function disc(x, cx, cy, r, col) { for (let j = -r; j <= r; j++) for (let i = -r; i <= r; i++) if (i * i + j * j <= r * r + r * .6) R(x, col, cx + i, cy + j); }
function ell(x, cx, cy, rx, ry, col) { for (let j = -ry; j <= ry; j++) for (let i = -rx; i <= rx; i++) if ((i * i) / (rx * rx + .5) + (j * j) / (ry * ry + .5) <= 1) R(x, col, cx + i, cy + j); }

/* ---------------- INPUT ---------------- */
const KEYMAP = { ArrowUp: 'up', KeyW: 'up', ArrowDown: 'down', KeyS: 'down', ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right',
  KeyZ: 'a', Space: 'a', KeyE: 'a', Enter: 'a', NumpadEnter: 'a', KeyX: 'b', Escape: 'b', Backspace: 'b', ShiftLeft: 'b', KeyM: 'menu', Tab: 'menu', KeyI: 'menu', KeyC: 'sniff', KeyQ: 'sniff' };
const DIRS = ['up', 'down', 'left', 'right'];
const DV = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };
const held = new Set(), justSet = new Set();
let just = new Set(), dirStack = [];
function press(k) { if (!held.has(k)) { justSet.add(k); if (DIRS.includes(k)) { dirStack = dirStack.filter(d => d !== k); dirStack.push(k); } } held.add(k); audioInit(); }
function release(k) { held.delete(k); dirStack = dirStack.filter(d => d !== k); }
addEventListener('keydown', e => { if (e.target && e.target.tagName === 'INPUT') return; const k = KEYMAP[e.code]; if (k) { e.preventDefault(); press(k); } });
addEventListener('keyup', e => { const k = KEYMAP[e.code]; if (k) release(k); });
addEventListener('blur', () => { held.clear(); dirStack = []; });
document.querySelectorAll('.pbtn').forEach(b => {
  const k = b.dataset.k;
  const on = e => { e.preventDefault(); b.classList.add('on'); press(k); try { b.setPointerCapture(e.pointerId); } catch (_) {} };
  const off = e => { b.classList.remove('on'); release(k); };
  b.addEventListener('pointerdown', on); b.addEventListener('pointerup', off); b.addEventListener('pointercancel', off); b.addEventListener('lostpointercapture', off);
  b.addEventListener('contextmenu', e => e.preventDefault());
});
const jp = k => just.has(k);
const curDir = () => dirStack.length ? dirStack[dirStack.length - 1] : null;

/* ---------------- AUDIO ---------------- */
let AC = null;
function audioInit() { if (AC) return; try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} }
function tone(f, d, type = 'square', v = .05, t0 = 0, slide = 0) {
  if (!AC || (typeof state !== 'undefined' && state && state.sound === false)) return;
  const t = AC.currentTime + t0, o = AC.createOscillator(), g = AC.createGain();
  o.type = type; o.frequency.setValueAtTime(f, t); if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(30, f + slide), t + d);
  g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + d); o.connect(g).connect(AC.destination); o.start(t); o.stop(t + d + .02);
}
const SFX = {
  blip: () => tone(900, .025, 'square', .018), sel: () => tone(660, .05, 'square', .035),
  ok: () => { tone(660, .07); tone(990, .09, 'square', .05, .07); }, no: () => tone(170, .14, 'square', .05, 0, -70),
  bark: () => { tone(560, .06, 'sawtooth', .045, 0, -220); tone(600, .07, 'sawtooth', .045, .11, -260); },
  coin: () => { tone(988, .06, 'square', .045); tone(1319, .16, 'square', .045, .06); },
  snap: () => { tone(2200, .03, 'square', .04); tone(320, .09, 'triangle', .07, .03); },
  chop: () => tone(240, .05, 'triangle', .09, 0, -110), plop: () => tone(420, .06, 'sine', .08, 0, 200),
  win: () => [523, 659, 784, 1047].forEach((f, i) => tone(f, .16, 'square', .045, i * .1)),
  door: () => tone(330, .09, 'triangle', .07, 0, -90), find: () => [784, 988, 1175].forEach((f, i) => tone(f, .1, 'square', .04, i * .08)),
  sniff: () => [0, .14, .28].forEach(t => tone(900, .05, 'triangle', .03, t, -500)),
  arf: () => { tone(300, .08, 'sawtooth', .04, 0, -80); tone(280, .1, 'sawtooth', .04, .12, -90); }
};

/* ---------------- TINY FONT (signs) ---------------- */
const TF = {A:'010101111101101',B:'110101110101110',C:'011100100100011',D:'110101101101110',E:'111100110100111',F:'111100110100100',G:'011100101101011',H:'101101111101101',I:'111010010010111',J:'001001001101010',K:'101101110101101',L:'100100100100111',M:'101111111101101',N:'110101101101101',O:'010101101101010',P:'110101110100100',Q:'010101101110011',R:'110101110101101',S:'011100010001110',T:'111010010010010',U:'101101101101111',V:'101101101101010',W:'101101111111101',X:'101101010101101',Y:'101101010010010',Z:'111001010100111',
  '0':'111101101101111','1':'010110010010111','2':'110001010100111','3':'110001010001110','4':'101101111001001','5':'111100110001110','6':'011100111101111','7':'111001010010010','8':'111101111101111','9':'111101111001110',
  '-':'000000111000000','.':'000000000000010','!':'010010010000010','$':'011110010011110',':':'000010000010000','>':'100010001010100','<':'001010100010001',' ':'000000000000000','Í':'010000010010010','É':'010000111110111','Ñ':'111000110101101','Á':'010000010111101','Ó':'010000010101010'};
function tiny(x, str, X, Y, col) { let cx = X; for (const ch of str.toUpperCase()) { const g = TF[ch] || TF[' ']; for (let i = 0; i < 15; i++) if (g[i] === '1') R(x, col, cx + i % 3, Y + (i / 3 | 0)); cx += 4; } }
const tinyW = s => s.length * 4 - 1;

/* ---------------- SPRITES ---------------- */
const PAL_G = { o: '#2b1d22', h: '#7a4a2e', H: '#5a321f', i: '#a8714b', s: '#f6d0ae', S: '#dca887', g: '#2a2232', w: '#cfe6ff', e: '#3b2a3e', m: '#c95f6a', t: '#b2b7bf', T: '#8a909b', k: '#33333f', K: '#1f1f29', j: '#4365a3', J: '#2e4b7e', b: '#7c3426' };
const LEG_F = { s: ['...ojjjoojjjo...', '...ojjjoojjjo...', '...obbboobbbo...', '...oooo..oooo...'],
  a: ['...ojjjoojjjo...', '...ojjjoobbbo...', '...obbbo.oooo...', '...oooo.........'] };
LEG_F.b = LEG_F.a.map(rev);
const LEG_S = { s: ['....ojjjjo......', '....ojjjjo......', '...obbbbbo......', '...ooooooo......'],
  a: ['...ojjoojjo.....', '..ojjo..ojjo....', '.obbbo..obbbo...', '.oooo....oooo...'],
  b: ['....ojjjjo......', '....ojjjo.......', '...obbbbo.......', '...oooooo.......'] };
const G_DOWN = [
  '....oooooooo....', '...ohhhhhhhho...', '..ohhhhiihhhho..', '.ohhhhhhhhhhhho.', '.ohhhhhshhhhhho.', '.ohhsssssssshho.',
  '.ohhgwggggwghho.', '.ohhgegssgeghho.', '.ohhSssmmssShho.', '.ohhhSssssShhho.', '.ohhtktsstkthho.', '.otttkttttkttto.',
  '.osTtkttttktTso.', '.osTTTTTTTTTTso.', '..ojjjjjjjjjjo..', '...ojjjjjjjjo...'];
const G_UP = [
  '....oooooooo....', '...ohhhhhhhho...', '..ohhhhiihhhho..', '.ohhhhhhhhhhhho.', '.ohhhhhhhhhhhho.', '.ohhhhhihhhhhho.',
  '.ohhhhhhhhhhhho.', '.ohhhHhhhhHhhho.', '.ohhhhhhhhhhhho.', '.oHhhhhhhhhhhHo.', '.ohhkkkkkkkkhho.', '.otkkKkkkkKkkto.',
  '.oskkkkkkkkkkso.', '.osTkKKKKKKkTso.', '..ojjjjjjjjjjo..', '...ojjjjjjjjo...'];
const G_LEFT = [
  '.....oooooo.....', '....ohhhhhhho...', '...ohhhhhiihho..', '..ohhhhhhhhhhho.', '..ohshhhhhhhhho.', '.ossssshhhhhhho.',
  '.ogwggghhhhhhho.', '.ogegsshhhhhhho.', '.ossmsShhhhhhho.', '..oSssShhhhhhho.', '..otttttkkkkho..', '..otttttkKKkko..',
  '..otsSttkKKkko..', '..oTsTTTkkkkko..', '...ojjjjjjjo....', '...ojjjjjjo.....'];
function frames3(body, legs, pal, name) { return ['s', 'a', 'b'].map(k => grid(body.concat(legs[k]), pal, name)); }
function makeWalker(down, up, left, pal, name) {
  const L = frames3(left, LEG_S, pal, name + 'L');
  return { down: frames3(down, LEG_F, pal, name + 'D'), up: frames3(up, LEG_F, pal, name + 'U'), left: L, right: L.map(flipC) };
}
const SPR = {};
SPR.grecia = makeWalker(G_DOWN, G_UP, G_LEFT, PAL_G, 'grecia');

/* generic NPC */
const N_DOWN = ['................', '.....oooooo.....', '....ohhhhhho....', '...ohhhhhhhho...', '...ohhhhhhhho...', '...ohssssssho...',
  '...osesssseso...', '...ossssssssο...', '...oSssmmssSo...', '....oSssssSo....', '...otttttttto...', '..otttttttttto..',
  '..osttttttttso..', '..osTTTTTTTTso..', '...ojjjjjjjjo...', '...ojjjjjjjjo...'];
N_DOWN[7] = '...o' + 'ssssssss' + 'o...';
const N_UP = N_DOWN.slice(); N_UP[5] = '...ohhhhhhhho...'; N_UP[6] = '...ohhhhhhhho...'; N_UP[7] = '...ohhhhhhhho...'; N_UP[8] = '...oShhhhhhSo...';
const N_LEFT = ['................', '.....oooooo.....', '....ohhhhhho....', '...ohhhhhhhho...', '...ohhhhhhhho...', '...osssshhhho...',
  '...osesshhhho...', '...ossssShhho...', '...osmsSShhho...', '....oSsssSho....', '....otttttto....', '....otttttto....',
  '....otssttto....', '....oTsTTTTo....', '....ojjjjjjo....', '....ojjjjjjo....'];
const npcCache = {};
function npcSprite(p) {
  const key = JSON.stringify(p); if (npcCache[key]) return npcCache[key];
  const pal = { o: '#2b1d22', h: p.hair, s: p.skin || '#f0c8a2', S: p.skinD || '#d4a07c', e: '#2a2030', m: '#b8606a', t: p.shirt, T: p.shirtD, j: p.pants, J: p.pants, b: p.shoes || '#3a2a24' };
  return (npcCache[key] = makeWalker(N_DOWN, N_UP, N_LEFT, pal, 'npc'));
}

/* STINKY — bulldog inglés */
const PAL_P = { o: '#2a1f1c', w: '#f3ede2', W: '#d6cbbb', f: '#c08a52', F: '#8f5e34', e: '#1a1414', n: '#1a1414', p: '#e2808a', T: '#fffbe6', c: '#3aa6a0', g: '#e8b23a' };
const P_D = ['..oo........oo..', '.oFfoooooooofFo.', '.offwwwwwwwwffo.', 'owwwwwwwwwwwwwwo', 'owwewwwwwwwwewwo', 'owWwwWWnnWWwwWwo',
  'owwWWwnnnnwWWwwo', '.owwpwTwwTwpwwo.', '..oWWccccccWWo..', '.owwwwwgwwwwwwo.', '.owwwfffwwwwwwo.', '.oWwwwwwwwwwwWo.'];
const P_U = ['..oo........oo..', '.oFfoooooooofFo.', '.offwwwwwwwwffo.', 'owwwwwwwwwwwwwwo', 'owwwwwwwwwwwwwwo', 'oWwwwwwwwwwwwwWo',
  '.oWwwwwwwwwwwWo.', '..oWccccccccWo..', '.owwwffffwwwwwo.', '.owwffFffwwwwwo.', '.owwwwwoowwwwwo.', '.oWwwwwwwwwwwWo.'];
const P_L = ['................', '..ooo...........', '.oFwwoo.........', 'owwewwwo........', 'oWwwwwwwoooooo..', 'onWWwwwwwwwwwwo.',
  'oWpTwwccwwwfffwo', '.oWwwwccwwffFfwo', '..owwwwwwwwfffWo', '..oWwwwwwwwwwwWo', '..oWWwwwwwwwWWo.', '...oWWWWWWWWWo..'];
const PLEG_F = { s: ['..owwo....owwo..', '..ooo......ooo..'], a: ['..owwo....owwo..', '...oo......ooo..'] }; PLEG_F.b = PLEG_F.a.map(rev);
const PLEG_S = { s: ['...owo.....owo..', '...oo......oo...'], a: ['..owo.......owo.', '..oo........oo..'], b: ['....owo...owo...', '....oo....oo....'] };
(() => { const L = frames3(P_L, PLEG_S, PAL_P, 'dogL'); SPR.pug = { down: frames3(P_D, PLEG_F, PAL_P, 'dogD'), up: frames3(P_U, PLEG_F, PAL_P, 'dogU'), left: L, right: L.map(flipC) }; })();

/* UNRYU — Ryu mascota: rojo, lentes redondos, melena blanca, aletas turquesa, cola de nube */
const PAL_U = { o: '#2a1210', r: '#e0432b', R: '#a8281f', c: '#f6dfb0', C: '#dcbd82', w: '#ffffff', W: '#d8d4cc', g: '#141012', e: '#141012', s: '#ffffff', t: '#3aa6a0', k: '#ff8a7a' };
const U_ROWS = ['..w............w..', '..ww..owwwo...ww..', '...wwowwwwwo.ww...', '....orrrrrrrro....', '...orrrrrrrrrro...', '..orggggrrggggro..',
  '.torgesgrrgesgrot.', '.torgeeggggeegrot.', '..orggggrrggggro..', '..orrrkrrrrkrrro..', '...orrrRooRrrro...', '....oRrrrrrrRo....',
  '...torccccccrot...', '..orrcCccccCcrro..', '.orRrccccccccrRro.', '.orRrcCccccCcrRro.', '..orrcccccccrrro..', '..orRro....orRro..', '..ooooo....ooooo..'];
(() => {
  const base = grid(U_ROWS, PAL_U, 'unryu');
  const f = [0, 1].map(k => { const [c, x] = mk(26, 20); x.drawImage(base, 0, 0);
    const pts = k ? [[16, 14], [17, 13], [18, 12], [19, 11], [20, 10]] : [[16, 15], [17, 15], [18, 14], [19, 14], [20, 13]];
    pts.forEach(([a, b]) => { R(x, '#2a1210', a, b - 1, 1, 3); R(x, '#e0432b', a, b, 1, 1); });
    const [ex, ey] = pts[4]; // spiral cloud tip
    [[1, -2], [2, -2], [3, -1], [3, 0], [2, 1], [1, 1], [0, 0], [1, -1], [2, 0]].forEach(([a, b], i) => R(x, i > 6 ? '#3aa6a0' : '#ffffff', ex + a, ey + b));
    [[0, -3], [1, -3], [2, -3], [3, -3], [4, -2], [4, -1], [4, 0], [4, 1], [3, 2], [2, 2], [1, 2], [0, 1], [-1, 0]].forEach(([a, b]) => R(x, '#2a1210', ex + a, ey + b));
    return c; });

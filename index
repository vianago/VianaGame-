function buildLayer(m) {
  const [c, x] = mk(m.w * TS, m.h * TS);
  for (let ty = 0; ty < m.h; ty++) for (let tx = 0; tx < m.w; tx++) drawStaticTile(x, m, tx, ty);
  if (m.decor) m.decor.forEach(d => x.drawImage(d.spr, d.x, d.y));
  if (m.bridge) { const b = m.bridge; const [bc, bx] = mk((b.x1 - b.x0 + 1) * TS, (b.y1 - b.y0 + 1) * TS); bx.drawImage(c, b.x0 * TS, b.y0 * TS, bc.width, bc.height, 0, 0, bc.width, bc.height); m.bridgeLayer = bc; }
  m.layer = c; return c;
}

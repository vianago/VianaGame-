  [[27, 14], [27, 15], [27, 16], [28, 17]].forEach(([a, b]) => setT(m, a, b, 'P')); setT(m, 28, 18, 's');
  [[5, 19], [9, 21], [13, 20], [22, 20], [24, 17], [33, 17], [11, 18], [20, 22], [3, 22]].forEach(([a, b]) => setT(m, a, b, 'p'));
  setT(m, 30, 21, 'n');
  addObj(m, { id: 'piedra', x: 28, y: 19, w: 2, h: 2, spr: PROP.rockBig, oy: -2, interact: () => story.scaleStone() });

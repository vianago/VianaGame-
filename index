const RIVER_TOP = [15, 15, 16, 16, 16, 15, 15, 15, 16, 16, 17, 17, 17, 16, 16, 16, 16, 15, 15, 15, 15, 16, 16, 16, 15, 15, 15, 14, 14, 14, 14, 15, 15, 15, 15, 15];
function buildRiver() {
  const m = makeMap('river', 36, 26, '.'); m.name = 'EL RÍO'; m.sub = 'Sendero del Calle-Calle'; m.outdoor = true; m.zone = true;
  fillT(m, 0, 0, 36, 2, 'T'); fillT(m, 0, 24, 36, 2, 'T'); for (let y = 0; y < 26; y++) { setT(m, 0, y, 'T'); setT(m, 35, y, 'T'); }
  setT(m, 0, 12, 'e'); setT(m, 0, 13, 'e');
  for (let x = 1; x < 35; x++) { const top = RIVER_TOP[x]; setT(m, x, top - 1, hash(x, 1) < .45 ? 'k' : 's'); for (let y = top; y < 24; y++) setT(m, x, y, '~'); }
  // forest north
  [[2, 2], [4, 3], [3, 5], [6, 2], [11, 2], [13, 3], [12, 5], [15, 2], [21, 2], [23, 4], [25, 2], [28, 3], [30, 2], [32, 4], [33, 2], [27, 6], [22, 7], [14, 7], [2, 8], [33, 8], [31, 11], [3, 10], [26, 10], [10, 9], [20, 4], [8, 8], [16, 5]].forEach(([a, b]) => setT(m, a, b, 'T'));
  fillT(m, 5, 4, 5, 4, 'g'); setT(m, 7, 4, 'T'); fillT(m, 29, 5, 3, 3, 'g'); fillT(m, 17, 8, 3, 2, 'g');
  [[9, 5], [4, 7], [18, 3], [24, 7], [29, 8], [12, 10], [21, 11], [6, 11], [28, 12]].forEach(([a, b]) => { if (T(m, a, b) === '.') setT(m, a, b, 'n'); });
  [[11, 11], [24, 12], [32, 13]].forEach(([a, b]) => setT(m, a, b, 'R'));
  // path
  for (let x = 0; x < 17; x++) setT(m, x, x < 8 ? 12 : 13, 'e'); setT(m, 8, 12, 'e'); for (let x = 17; x < 30; x++) setT(m, x, 13, 'e'); setT(m, 17, 14, 'e'); setT(m, 18, 14, 'e');
  for (let y = 3; y < 12; y++) setT(m, 18, y, y === 3 ? 'e' : (T(m, 18, y) === 'T' ? 'e' : 'e')); setT(m, 18, 2, 'e'); setT(m, 18, 1, 'e'); setT(m, 18, 0, 'T');
  // dock
  fillT(m, 17, 15, 2, 5, 'd');

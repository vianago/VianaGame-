function makeMap(id, w, h, fill) { const t = []; for (let y = 0; y < h; y++) t.push(new Array(w).fill(fill)); return { id, w, h, t, objs: [], npcs: [], warps: [], events: [], name: '', layer: null }; }
function setT(m, x, y, c) { if (x >= 0 && y >= 0 && x < m.w && y < m.h) m.t[y][x] = c; }
function fillT(m, x, y, w, h, c) { for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) setT(m, i, j, c); }
function T(m, x, y) { return (x < 0 || y < 0 || x >= m.w || y >= m.h) ? 'x' : m.t[y][x]; }
function addObj(m, o) { o.w = o.w || 1; o.h = o.h || 1; if (o.solid === undefined) o.solid = true; if (!o.sort) o.sort = 'y'; m.objs.push(o); return o; }

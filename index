/* ---------------- CREATURE SPAWNS ---------------- */
function spawnTick(force) {
  const list = G.map && (G.map.id === 'river' ? SPAWNS : G.map.id === 'town' ? TOWN_SPAWNS : null); if (!list) return;
  const h = hour(); if (!force && h === G.lastHour) return; G.lastHour = h;
  list.forEach((s, i) => {
    const key = G.map.id + i + ':' + state.week + ':' + state.day + ':' + (isNight() ? 'n' : 'd') + (fogNow() ? 'f' : '') + state.weather;
    const existing = G.creatures.find(c => c.si === i && !c.gone);
    if (!s.cond()) { if (existing && existing.hidden) G.creatures = G.creatures.filter(c => c !== existing); return; }
    if (existing || G.spawnRolled[key]) return; G.spawnRolled[key] = true;
    if (Math.random() <= s.ch) G.creatures.push({ si: i, cr: s.cr, x: s.x, y: s.y, hidden: true, alpha: 0, gone: false, t: Math.random() * 6, quest: !!s.quest });
  });
}
/* ---------------- ACTORS ---------------- */
function mkActor(x, y, dir) { return { x, y, px: x * TS, py: y * TS, dir, moving: false, fx: x, fy: y, tx: x, ty: y, prog: 0, speed: 4, animT: 0, idleT: 0, turnT: 0, bumpT: 0 }; }
function beginMove(a, dir, speed) { const [dx, dy] = DV[dir]; a.dir = dir; a.fx = a.x; a.fy = a.y; a.tx = a.x + dx; a.ty = a.y + dy; a.moving = true; a.prog = 0; a.speed = speed; }

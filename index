// "has" = lo lleva consigo. Los objetos personales vuelven a su lugar en casa cada mañana (state.home).
const has = id => !!(state.inv[id]) && !(state.home && state.home[id]);
function give(id, n = 1, quiet) { state.inv[id] = (state.inv[id] || 0) + n; if (state.home) delete state.home[id]; if (!quiet) { toast('Conseguiste: ' + ITEMS[id].name); SFX.find(); } }
function addMoney(n, label) { state.money += n; toast((n >= 0 ? '+' : '') + money(n) + (label ? '  ' + label : ''), 'money'); if (n > 0) SFX.coin(); }
function addDiary(txt) { state.diary.unshift({ d: DAYS[state.day] + ' · semana ' + state.week, t: txt }); }
const dog = () => state.dogName || 'PUG';
const level = () => 1 + Math.floor(state.xp / 60);

/* time & weather */
const hour = () => Math.floor(state.time / 60);
function clockStr(t = state.time) { const h = Math.floor(t / 60) % 24, m = Math.floor(t % 60); return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0'); }
function nightAmt() { const t = state.time; if (t >= 1110 && t < 1200) return (t - 1110) / 90; if (t >= 1200 || t < 360) return 1; if (t < 450) return 1 - (t - 360) / 90; return 0; }
const isNight = () => nightAmt() > .55;
const riverFog = () => G.map && G.map.id === 'river' && state.time >= 1140;
const fogNow = () => state.weather === 'niebla' || riverFog();
function wxNow() { if (isNight()) return 'noche'; if (riverFog()) return 'niebla'; return state.weather; }
function weatherFor(week, day) { if (week === 1) return WEEK1_WX[day]; const r = hash(week, day, 7); return r < .45 ? 'lluvia' : r < .75 ? 'sol' : 'niebla'; }
const startTimeFor = d => d < 5 ? 450 : d === 5 ? 555 : 600;
const raining = () => state.weather === 'lluvia' && G.map && G.map.outdoor;

